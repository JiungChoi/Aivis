# =============================================
# Phase 3 — Scale & Expand
# Phase 2 + 유료 서비스 전환 가능 구조
# Ollama → Claude API 교체 시 아래 주석 해제
# =============================================

# Database (Docker PostgreSQL)
DATABASE__CONNECTIONSTRING=Host=localhost;Port=5432;Database=aivis;Username=aivis;Password=aivis1234

# LLM - 아래 중 하나 선택
# [Option A] Ollama 로컬 (무료)
OLLAMA__BASEURL=http://localhost:11434
OLLAMA__MODEL=llama3.2
# [Option B] Claude API (유료, 주석 해제 시 교체)
# ANTHROPIC__APIKEY=
# ANTHROPIC__MODEL=claude-opus-4-7

# STT - Whisper 로컬
WHISPER__MODELPATH=./models/whisper
WHISPER__LANGUAGE=ko

# TTS - Edge TTS
TTS__VOICE=ko-KR-SunHiNeural

# Vector DB - ChromaDB
CHROMADB__BASEURL=http://localhost:8000
CHROMADB__COLLECTION=aivis

# Obsidian Vault
OBSIDIAN__VAULTPATH=/Users/your_username/obsidian-vault

# App
APP__PORT=5050
APP__ENVIRONMENT=Production
